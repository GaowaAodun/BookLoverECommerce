@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<!-- HERO / CAMPAIGN -->
<section class="hero-section">
    <div class="container">
        <div class="hero-content">

            <span class="hero-badge">
                Summer Reading Campaign
            </span>

            <h1>
                Discover stories you'll
                <span>never forget.</span>
            </h1>

            <p>
                Explore bestselling books, exclusive collections,
                and special discounts hand-picked for book lovers.
            </p>

            <div class="hero-actions">
                <a asp-page="/Products/Index"
                   class="btn btn-dark btn-lg">
                    Explore Books
                </a>

                <a href="#recommended"
                   class="btn btn-outline-dark btn-lg">
                    View Recommendations
                </a>
            </div>

            <div class="hero-offer">
                <strong>20% OFF</strong>
                selected books this week
            </div>

        </div>
    </div>
</section>


<!-- CATEGORY SECTION -->
<section class="category-section">
    <div class="container">

        <div class="section-heading">
            <div>
                <span class="section-label">
                    EXPLORE
                </span>

                <h2>Browse by category</h2>
            </div>

            <a asp-page="/Products/Index">
                View all
            </a>
        </div>

        <div class="category-grid">

            <a class="category-card"
   asp-page="/Products/Index"
   asp-route-category="Fiction">

    <span>📖</span>

    <h3>Fiction</h3>

    <p>
        Explore stories and novels
    </p>

</a>

            <a class="category-card"
   asp-page="/Products/Index"
   asp-route-category="Technology">

    <span>💻</span>

    <h3>Technology</h3>

    <p>
        Programming and innovation
    </p>

</a>

            <a class="category-card"
   asp-page="/Products/Index"
   asp-route-category="Business">

    <span>📈</span>

    <h3>Business</h3>

    <p>
        Ideas for growth
    </p>

</a>

            <a class="category-card"
   asp-page="/Products/Index"
   asp-route-category="Self Development">

    <span>🌱</span>

    <h3>Self Development</h3>

    <p>
        Personal growth and better habits
    </p>

</a>

        </div>

    </div>
</section>


<!-- RECOMMENDED BOOKS -->
<section class="products-section"
         id="recommended">

    <div class="container">

        <div class="section-heading">
            <div>
                <span class="section-label">
                    FOR YOU
                </span>

                <section class="products-section"
         id="recommended">

    <div class="container">

        <div class="section-heading">

            <div>

                <span class="section-label">
                    FOR YOU
                </span>

                <h2>
                    Recommended Books
                </h2>

            </div>

            <a asp-page="/Products/Index">
                See all books
            </a>

        </div>


        @if (Model.RecommendedProducts.Count == 0)
        {
            <div class="alert alert-light">
                Recommendations will appear here when
                products become available.
            </div>
        }
        else
        {
            <div class="book-grid">

                @foreach (var product in Model.RecommendedProducts)
                {
                    <article class="book-card">

                        <!-- IMAGE -->
                        <a asp-page="/Products/Details"
                           asp-route-id="@product.Id"
                           class="book-image-link">

                            <div class="book-image-placeholder">

                                @if (!string.IsNullOrWhiteSpace(
                                    product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Title"
                                         class="homepage-book-image" />
                                }
                                else
                                {
                                    <span>
                                        📖
                                    </span>
                                }

                            </div>

                        </a>


                        <!-- INFORMATION -->
                        <div class="book-info">

                            @if (!string.IsNullOrWhiteSpace(
                                product.Category))
                            {
                                <span class="book-category">
                                    @product.Category
                                </span>
                            }


                            <h3>

                                <a asp-page="/Products/Details"
                                   asp-route-id="@product.Id"
                                   class="product-title-link">

                                    @product.Title

                                </a>

                            </h3>


                            @if (!string.IsNullOrWhiteSpace(
                                product.Author))
                            {
                                <p class="author">
                                    @product.Author
                                </p>
                            }


                            <div class="book-footer">

                                <strong>
                                    @product.Price.ToString("C")
                                </strong>


                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form method="post"
                                          asp-page="/Cart/Index"
                                          asp-page-handler="Add">

                                        <input type="hidden"
                                               name="productId"
                                               value="@product.Id" />

                                        <input type="hidden"
                                               name="quantity"
                                               value="1" />

                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@Request.Path" />

                                        <button type="submit"
                                                class="cart-button">

                                            Add to Cart

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <a asp-page="/Account/Login"
                                       asp-route-returnUrl="@Request.Path"
                                       class="cart-button">

                                        Login to Add

                                    </a>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>

<!-- PROMOTIONAL AD -->
<section class="promo-section">
    <div class="container">

        <div class="promo-banner">

            <div>
                <span class="promo-label">
                    LIMITED TIME
                </span>

                <h2>
                    Buy 2 books,
                    get the 3rd one 50% off.
                </h2>

                <p>
                    Mix and match selected titles from our
                    summer reading collection.
                </p>

                <a asp-page="/Products/Index"
                   class="btn btn-light">
                    Shop Campaign
                </a>
            </div>

            <div class="promo-visual">
                📚
            </div>

        </div>

    </div>
</section>


<!-- PRODUCT SEARCH -->
<section class="search-products-section">

    <div class="container">

        <div class="section-heading">

            <div>
                <span class="section-label">
                    SEARCH
                </span>

                <h2>Find your next book</h2>
            </div>

        </div>


        <form method="get"
      asp-page="/Products/Index"
      class="advanced-search">

    <div class="search-field">

        <label>
            Search books
        </label>

        <input type="text"
               name="search"
               class="form-control"
               placeholder="Book title or author..." />

    </div>


    <div class="search-field">

        <label>
            Sort by
        </label>

        <select name="sort"
                class="form-select">

            <option value="">
                Featured
            </option>

            <option value="name_asc">
                Name: A - Z
            </option>

            <option value="price_asc">
                Price: Low to High
            </option>

            <option value="price_desc">
                Price: High to Low
            </option>

        </select>

    </div>


    <div class="search-button-container">

        <button type="submit"
                class="btn btn-dark">
            Search Books
        </button>

    </div>

</form>

    </div>

</section>