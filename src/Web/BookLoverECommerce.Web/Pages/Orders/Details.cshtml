@page "{id:guid}"
@model BookLoverECommerce.Web.Pages.Orders.DetailsModel 

@{
    ViewData["Title"] = "Order Details";
}

<section class="order-details-page">

    <div class="container">

        <!-- =========================
             BACK LINK
        ========================== -->

        <a asp-page="/Orders/Index"
           class="order-back-link">
            ← Back to Orders
        </a>


        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger mt-4">
                @Model.ErrorMessage
            </div>
        }


        @if (Model.Order is not null)
        {
            <!-- =========================
                 ORDER HEADER
            ========================== -->

            <div class="order-details-header">

                <div>

                    <span class="section-label">
                        ORDER DETAILS
                    </span>

                    <h1>
                        @Model.Order.OrderNumber
                    </h1>


                    <div class="order-header-meta">

                        <span class="order-date">
    📅 Placed on
    @(Model.Order.CreatedAtUtc
        .ToLocalTime()
        .ToString("MMMM dd, yyyy 'at' h:mm tt"))
</span>


                        @{
                            var statusClass =
                                Model.Order.Status?.ToLowerInvariant() switch
                                {
                                    "pendingpayment" => "status-pending",
                                    "paid" => "status-paid",
                                    "processing" => "status-processing",
                                    "shipped" => "status-shipped",
                                    "completed" => "status-completed",
                                    "cancelled" => "status-cancelled",
                                    _ => "status-default"
                                };
                        }

                        <span class="order-status-badge @statusClass">
                            @Model.Order.Status
                        </span>

                    </div>

                </div>

            </div>


            <!-- =========================
                 MAIN LAYOUT
            ========================== -->

            <div class="order-details-layout">


                <!-- =========================
                     LEFT SIDE
                ========================== -->

                <main class="order-main-content">


                    <!-- PURCHASED ITEMS -->

                    <section class="order-card">

                        <div class="order-card-header">

                            <div>

                                <span class="section-label">
                                    YOUR ORDER
                                </span>

                                <h2>
                                    Purchased Items
                                </h2>

                            </div>


                            <span class="order-item-count">
                                @Model.Order.TotalQuantity
                                item@(Model.Order.TotalQuantity == 1 ? "" : "s")
                            </span>

                        </div>


                        <div class="order-items-list">

                            @foreach (var item in Model.Order.Items)
                            {
                                <article class="order-item-row">


                                    <!-- PRODUCT IMAGE -->

                                    <div class="order-item-image">

                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.ProductName" />
                                        }
                                        else
                                        {
                                            <div class="order-item-placeholder">
                                                📖
                                            </div>
                                        }

                                    </div>


                                    <!-- PRODUCT INFO -->

                                    <div class="order-item-info">

                                        <h3>
                                            @item.ProductName
                                        </h3>


                                        <div class="order-item-meta">

                                            <span>
                                                Quantity:
                                                <strong>
                                                    @item.Quantity
                                                </strong>
                                            </span>

                                            <span class="order-meta-dot">
                                                •
                                            </span>

                                            <span>
                                                Unit price:
                                                <strong>
                                                    @item.UnitPrice.ToString("C")
                                                </strong>
                                            </span>

                                        </div>

                                    </div>


                                    <!-- TOTAL -->

                                    <div class="order-item-total">

                                        <span>
                                            Item total
                                        </span>

                                        <strong>
                                            @item.LineTotal.ToString("C")
                                        </strong>

                                    </div>

                                </article>
                            }

                        </div>

                    </section>


                    <!-- THANK YOU CARD -->

                    <section class="order-thankyou-card">

                        <div class="order-thankyou-icon">
                            📦
                        </div>

                        <div>

                            <h3>
                                Thank you for your order!
                            </h3>

                            <p>
                                Your order has been received successfully.
                                You can track its status from your orders page.
                            </p>

                        </div>

                    </section>


                    <!-- CONTINUE SHOPPING -->

                    <a asp-page="/Products/Index"
                       class="btn btn-dark btn-lg w-100 order-continue-button">

                        Continue Shopping

                    </a>

                </main>


                <!-- =========================
                     RIGHT SIDE SUMMARY
                ========================== -->

                <aside class="order-summary-card">

                    <span class="section-label">
                        PAYMENT SUMMARY
                    </span>

                    <h2>
                        Order Total
                    </h2>


                    <div class="order-summary-highlight">

                        <span>
                            Total
                        </span>

                        <strong>
                            @Model.Order.Total.ToString("C")
                        </strong>

                    </div>


                    <div class="order-summary-row">

                        <span>
                            Subtotal
                        </span>

                        <strong>
                            @Model.Order.Subtotal.ToString("C")
                        </strong>

                    </div>


                    <div class="order-summary-row">

                        <span>
                            Shipping
                        </span>

                        @if (Model.Order.ShippingAmount == 0)
                        {
                            <strong class="order-free">
                                Free
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @Model.Order.ShippingAmount.ToString("C")
                            </strong>
                        }

                    </div>


                    <hr />


                    <div class="order-summary-total">

                        <span>
                            Total
                        </span>

                        <strong>
                            @Model.Order.Total.ToString("C")
                        </strong>

                    </div>


                    <!-- STATUS INFO -->

                    <div class="order-status-info">

                        @if (
                            string.Equals(
                                Model.Order.Status,
                                "PendingPayment",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="order-status-message order-status-message-pending">

                                <strong>
                                    ⏳ Payment pending
                                </strong>

                                <p>
                                    Your order has been created.
                                    Payment confirmation is still pending.
                                </p>

                            </div>
                        }
                        else if (
                            string.Equals(
                                Model.Order.Status,
                                "Processing",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="order-status-message">

                                <strong>
                                    📦 Order processing
                                </strong>

                                <p>
                                    Your order is currently being prepared.
                                </p>

                            </div>
                        }
                        else if (
                            string.Equals(
                                Model.Order.Status,
                                "Shipped",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            <div class="order-status-message">

                                <strong>
                                    🚚 Order shipped
                                </strong>

                                <p>
                                    Your order is on its way.
                                </p>

                            </div>
                        }
                    </div>

                </aside>

            </div>
        }

    </div>

</section>