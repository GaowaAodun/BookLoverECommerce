@page
@model BookLoverECommerce.Web.Pages.Cart.IndexModel

@{
    ViewData["Title"] = "My Cart";
}

<section class="cart-page">

    <div class="container">

        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="cart-page-header">

            <div>
                <span class="section-label">
                    YOUR SHOPPING BAG
                </span>

                <h1>
                    My Cart
                </h1>

                <p>
                    Choose the products you want to purchase now,
                    update quantities, or save the others for later.
                </p>
            </div>

            <a asp-page="/Products/Index"
               class="btn btn-outline-dark">

                ← Continue Shopping

            </a>

        </div>


        <!-- =========================================
             SUCCESS MESSAGE
        ========================================== -->

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success cart-message">

                ✓ @Model.SuccessMessage

            </div>
        }


        <!-- =========================================
             ERROR MESSAGE
        ========================================== -->

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger cart-message">

                @Model.ErrorMessage

            </div>
        }


        <!-- =========================================
             EMPTY CART
        ========================================== -->

        @if (Model.DisplayItems.Count == 0)
        {
            <div class="empty-cart">

                <div class="empty-cart-icon">
                    🛒
                </div>

                <h2>
                    Your cart is empty
                </h2>

                <p>
                    You haven't added anything yet.
                    Explore our collection and find something you love.
                </p>

                <a asp-page="/Products/Index"
                   class="btn btn-dark btn-lg">

                    Browse Products

                </a>

            </div>
        }
        else
        {
            <!-- =========================================
                 SELECTION TOOLBAR
            ========================================== -->

            <div class="cart-selection-toolbar">

                <div class="cart-select-all">

                    <input type="checkbox"
                           id="selectAll"
                           class="cart-checkbox" />

                    <label for="selectAll">
                        Select all products
                    </label>

                </div>


                <span class="cart-total-count">

                    @Model.Cart.TotalItems
                    item@(Model.Cart.TotalItems == 1 ? "" : "s")
                    in cart

                </span>

            </div>


            <!-- =========================================
                 CART LAYOUT
            ========================================== -->

            <div class="cart-layout">


                <!-- =====================================
                     LEFT SIDE - ITEMS
                ====================================== -->

                <div class="cart-items-section">

                    @foreach (var item in Model.DisplayItems)
                    {
                        <article class="cart-item"
                                 id="cart-item-@item.ProductId">


                            <!-- PRODUCT SELECT -->

                            <div class="cart-item-selector">

                                <input type="checkbox"
                                       class="cart-checkbox product-select-checkbox"
                                       value="@item.ProductId"
                                       data-product-id="@item.ProductId"
                                       data-price="@item.Price"
                                       data-quantity="@item.Quantity"
                                       checked />

                            </div>


                            <!-- PRODUCT IMAGE -->

                            <div class="cart-item-image">

                                <a asp-page="/Products/Details"
                                   asp-route-id="@item.ProductId">

                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Title" />
                                    }
                                    else
                                    {
                                        <div class="cart-image-placeholder">
                                            📖
                                        </div>
                                    }

                                </a>

                            </div>


                            <!-- PRODUCT CONTENT -->

                            <div class="cart-item-content">


                                <!-- TOP -->

                                <div class="cart-item-main">

                                    <div>

                                        @if (!string.IsNullOrWhiteSpace(item.Category))
                                        {
                                            <span class="cart-item-category">

                                                @item.Category

                                            </span>
                                        }


                                        <h3>

                                            <a asp-page="/Products/Details"
                                               asp-route-id="@item.ProductId"
                                               class="cart-product-link">

                                                @item.Title

                                            </a>

                                        </h3>


                                        @if (!string.IsNullOrWhiteSpace(item.Author))
                                        {
                                            <p class="cart-item-author">

                                                by @item.Author

                                            </p>
                                        }

                                    </div>


                                    <!-- REMOVE -->

                                    <button type="button"
                                            class="cart-remove-button"
                                            onclick="openRemoveDialog(
                                                '@item.ProductId',
                                                '@Html.Raw(
                                                    System.Text.Encodings.Web.JavaScriptEncoder
                                                        .Default.Encode(item.Title))')">

                                        Remove

                                    </button>

                                </div>


                                <!-- UNIT PRICE -->

                                <div class="cart-item-price">

                                    @item.Price.ToString("C")

                                </div>


                                <!-- BOTTOM -->

                                <div class="cart-item-bottom">


                                    <!-- QUANTITY UPDATE -->

                                    <form method="post"
                                          asp-page-handler="Update"
                                          class="cart-quantity-form">

                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />


                                        <label for="quantity-@item.ProductId">

                                            Quantity

                                        </label>


                                        <div class="cart-quantity-control">

                                            <button type="button"
                                                    class="cart-quantity-button"
                                                    onclick="decreaseCartQuantity('@item.ProductId')">

                                                −

                                            </button>


                                            <input id="quantity-@item.ProductId"
                                                   type="number"
                                                   name="quantity"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   max="100"
                                                   class="cart-quantity-input"
                                                   data-product-id="@item.ProductId" />


                                            <button type="button"
                                                    class="cart-quantity-button"
                                                    onclick="increaseCartQuantity('@item.ProductId')">

                                                +

                                            </button>

                                        </div>


                                        <button type="submit"
                                                class="btn btn-sm btn-outline-dark">

                                            Update

                                        </button>

                                    </form>


                                    <!-- ITEM SUBTOTAL -->

                                    <div class="cart-item-subtotal">

                                        <span>
                                            Item subtotal
                                        </span>

                                        <strong>
                                            @item.Subtotal.ToString("C")
                                        </strong>

                                    </div>

                                </div>

                            </div>

                        </article>
                    }

                </div>


                <!-- =====================================
                     RIGHT SIDE - ORDER SUMMARY
                ====================================== -->

                <aside class="cart-summary">

                    <span class="summary-label">
                        YOUR ORDER
                    </span>

                    <h2>
                        Order Summary
                    </h2>


                    <!-- SELECTED PRODUCTS -->

                    <div class="cart-summary-row">

                        <span>
                            Selected products
                        </span>

                        <strong id="selectedProductCount">
                            0
                        </strong>

                    </div>


                    <!-- SELECTED QUANTITY -->

                    <div class="cart-summary-row">

                        <span>
                            Selected quantity
                        </span>

                        <strong id="selectedQuantity">
                            0
                        </strong>

                    </div>


                    <!-- SHIPPING -->

                    <div class="cart-summary-row">

                        <span>
                            Shipping
                        </span>

                        <span class="text-success">
                            Free
                        </span>

                    </div>


                    <hr />


                    <!-- TOTAL -->

                    <div class="cart-summary-total">

                        <span>
                            Selected Total
                        </span>

                        <strong id="selectedSubtotal">
                            $0.00
                        </strong>

                    </div>


                    <p class="cart-summary-note">

                        Only the selected products will continue
                        to checkout. Unselected products will remain
                        safely in your cart.

                    </p>


                    <!-- =================================
                         CHECKOUT FORM
                    ================================== -->

                    <form method="post"
                          asp-page-handler="Checkout"
                          id="checkoutForm">

                        <!--
                            JavaScript adds:
                            selectedProductIds
                            as hidden inputs here.
                        -->

                        <div id="selectedProductsContainer">
                        </div>


                        <button type="submit"
                                id="checkoutButton"
                                class="btn btn-dark btn-lg w-100">

                            Continue with Selected Items

                        </button>

                    </form>


                    <!-- CONTINUE SHOPPING -->

                    <a asp-page="/Products/Index"
                       class="btn btn-outline-dark w-100 mt-3">

                        Continue Shopping

                    </a>


                    <!-- SECURITY INFO -->

                    <div class="cart-summary-security">

                        <div>
                            ✓ Your cart is saved
                        </div>

                        <div>
                            ✓ Purchase only selected items
                        </div>

                        <div>
                            ✓ Secure checkout
                        </div>

                    </div>

                </aside>

            </div>


            <!-- =========================================
                 REMOVE CONFIRMATION DIALOG
            ========================================== -->

            <dialog id="removeDialog"
                    class="remove-dialog">

                <div class="remove-dialog-content">


                    <!-- CLOSE -->

                    <button type="button"
                            class="remove-dialog-close"
                            onclick="closeRemoveDialog()"
                            aria-label="Close">

                        ×

                    </button>


                    <!-- ICON -->

                    <div class="remove-dialog-icon">
                        🗑️
                    </div>


                    <h2>
                        Remove from cart?
                    </h2>


                    <p>

                        Are you sure you want to remove

                        <strong id="removeProductName">
                            this product
                        </strong>

                        from your cart?

                    </p>


                    <p class="remove-dialog-note">

                        You can always add it again later.

                    </p>


                    <!-- ACTIONS -->

                    <div class="remove-dialog-actions">

                        <button type="button"
                                class="btn btn-outline-dark"
                                onclick="closeRemoveDialog()">

                            Cancel

                        </button>


                        <form method="post"
                              asp-page-handler="Remove"
                              id="removeProductForm">

                            <input type="hidden"
                                   name="productId"
                                   id="removeProductId" />


                            <button type="submit"
                                    class="btn btn-danger">

                                Remove Item

                            </button>

                        </form>

                    </div>

                </div>

            </dialog>
        }

    </div>

</section>


@section Scripts
{
    <script>

        // =========================================
        // QUANTITY
        // =========================================

        function increaseCartQuantity(productId) {

            const input =
                document.getElementById(
                    `quantity-${productId}`);

            if (!input) {
                return;
            }

            let quantity =
                parseInt(input.value) || 1;

            if (quantity < 100) {

                quantity++;

                input.value =
                    quantity;

                updateCheckboxQuantity(
                    productId,
                    quantity);

                updateSelectedSummary();
            }
        }


        function decreaseCartQuantity(productId) {

            const input =
                document.getElementById(
                    `quantity-${productId}`);

            if (!input) {
                return;
            }

            let quantity =
                parseInt(input.value) || 1;

            if (quantity > 1) {

                quantity--;

                input.value =
                    quantity;

                updateCheckboxQuantity(
                    productId,
                    quantity);

                updateSelectedSummary();
            }
        }


        function updateCheckboxQuantity(
            productId,
            quantity) {

            const checkbox =
                document.querySelector(
                    `.product-select-checkbox[data-product-id="${productId}"]`);

            if (!checkbox) {
                return;
            }

            checkbox.dataset.quantity =
                quantity;
        }


        // Handle quantity manually typed
        document
            .querySelectorAll(
                ".cart-quantity-input")
            .forEach(input => {

                input.addEventListener(
                    "input",
                    function () {

                        let quantity =
                            parseInt(
                                this.value)
                            || 1;

                        if (quantity < 1) {
                            quantity = 1;
                        }

                        if (quantity > 100) {
                            quantity = 100;
                        }

                        const productId =
                            this.dataset.productId;

                        updateCheckboxQuantity(
                            productId,
                            quantity);

                        updateSelectedSummary();
                    });
            });



        // =========================================
        // REMOVE CONFIRMATION
        // =========================================

        function openRemoveDialog(
            productId,
            productName) {

            const dialog =
                document.getElementById(
                    "removeDialog");

            const productIdInput =
                document.getElementById(
                    "removeProductId");

            const productNameElement =
                document.getElementById(
                    "removeProductName");


            if (!dialog ||
                !productIdInput ||
                !productNameElement) {

                return;
            }


            productIdInput.value =
                productId;

            productNameElement.textContent =
                productName;


            dialog.showModal();
        }


        function closeRemoveDialog() {

            const dialog =
                document.getElementById(
                    "removeDialog");

            if (!dialog) {
                return;
            }

            dialog.close();
        }


        // Close popup when clicking outside
        const removeDialog =
            document.getElementById(
                "removeDialog");


        removeDialog?.addEventListener(
            "click",
            function (event) {

                const rectangle =
                    removeDialog
                        .getBoundingClientRect();


                const clickedInside =
                    event.clientX >= rectangle.left &&
                    event.clientX <= rectangle.right &&
                    event.clientY >= rectangle.top &&
                    event.clientY <= rectangle.bottom;


                if (!clickedInside) {

                    closeRemoveDialog();
                }
            });



        // =========================================
        // PRODUCT SELECTION
        // =========================================

        const selectAllCheckbox =
            document.getElementById(
                "selectAll");


        const productCheckboxes =
            document.querySelectorAll(
                ".product-select-checkbox");


        const selectedProductCount =
            document.getElementById(
                "selectedProductCount");


        const selectedQuantity =
            document.getElementById(
                "selectedQuantity");


        const selectedSubtotal =
            document.getElementById(
                "selectedSubtotal");


        const checkoutButton =
            document.getElementById(
                "checkoutButton");


        function updateSelectedSummary() {

            let productCount = 0;

            let totalQuantity = 0;

            let totalPrice = 0;


            productCheckboxes.forEach(
                checkbox => {

                    const cartItem =
                        checkbox.closest(
                            ".cart-item");


                    if (checkbox.checked) {

                        productCount++;


                        const quantity =
                            parseInt(
                                checkbox.dataset.quantity)
                            || 0;


                        const price =
                            parseFloat(
                                checkbox.dataset.price)
                            || 0;


                        totalQuantity +=
                            quantity;


                        totalPrice +=
                            price * quantity;


                        cartItem?.classList.add(
                            "cart-item-selected");
                    }
                    else {

                        cartItem?.classList.remove(
                            "cart-item-selected");
                    }
                });


            if (selectedProductCount) {

                selectedProductCount.textContent =
                    productCount;
            }


            if (selectedQuantity) {

                selectedQuantity.textContent =
                    totalQuantity;
            }


            if (selectedSubtotal) {

                selectedSubtotal.textContent =
                    totalPrice.toLocaleString(
                        "en-CA",
                        {
                            style: "currency",
                            currency: "CAD"
                        });
            }


            if (checkoutButton) {

                checkoutButton.disabled =
                    productCount === 0;
            }


            if (selectAllCheckbox) {

                const allSelected =
                    productCheckboxes.length > 0 &&
                    [...productCheckboxes]
                        .every(
                            checkbox =>
                                checkbox.checked);


                const someSelected =
                    [...productCheckboxes]
                        .some(
                            checkbox =>
                                checkbox.checked);


                selectAllCheckbox.checked =
                    allSelected;


                selectAllCheckbox.indeterminate =
                    someSelected &&
                    !allSelected;
            }
        }


        // Individual checkbox
        productCheckboxes.forEach(
            checkbox => {

                checkbox.addEventListener(
                    "change",
                    updateSelectedSummary);
            });


        // Select all
        selectAllCheckbox?.addEventListener(
            "change",
            function () {

                productCheckboxes.forEach(
                    checkbox => {

                        checkbox.checked =
                            selectAllCheckbox.checked;
                    });


                updateSelectedSummary();
            });



        // =========================================
        // CHECKOUT SUBMISSION
        // =========================================

        const checkoutForm =
            document.getElementById(
                "checkoutForm");


        const selectedProductsContainer =
            document.getElementById(
                "selectedProductsContainer");


        checkoutForm?.addEventListener(
            "submit",
            function (event) {

                if (!selectedProductsContainer) {

                    event.preventDefault();

                    return;
                }


                // Remove old hidden inputs
                selectedProductsContainer.innerHTML =
                    "";


                const selectedProducts =
                    document.querySelectorAll(
                        ".product-select-checkbox:checked");


                // Nothing selected
                if (selectedProducts.length === 0) {

                    event.preventDefault();


                    alert(
                        "Please select at least one product to continue.");

                    return;
                }


                // Add each selected ProductId
                // to the checkout form.
                selectedProducts.forEach(
                    checkbox => {

                        const input =
                            document.createElement(
                                "input");


                        input.type =
                            "hidden";


                        input.name =
                            "selectedProductIds";


                        input.value =
                            checkbox.value;


                        selectedProductsContainer
                            .appendChild(
                                input);
                    });
            });



        // =========================================
        // INITIAL PAGE CALCULATION
        // =========================================

        updateSelectedSummary();

    </script>
}