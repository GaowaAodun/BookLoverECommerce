@page
@model BookLoverECommerce.Web.Pages.Account.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="account-form-page">

    <div class="container">

        <div class="account-form-card">

            <div class="account-form-header">

                <span class="section-label">
                    ACCOUNT RECOVERY
                </span>

                <h1>
                    Forgot Password?
                </h1>

                <p>
                    Enter your email address and we'll help you
                    reset your password.
                </p>

            </div>

            @if (!string.IsNullOrWhiteSpace(
                Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-4">

                    <label asp-for="Input.Email"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control form-control-lg"
                           autocomplete="email"
                           placeholder="you@example.com" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="account-form-actions">

                    <a asp-page="/Account/Login"
                       class="btn btn-outline-dark btn-lg">
                        Back to Sign In
                    </a>

                    <button type="submit"
                            class="btn btn-dark btn-lg">
                        Continue
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}