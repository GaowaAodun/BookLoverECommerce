@page
@model BookLoverECommerce.Web.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <span class="auth-eyebrow">BOOKLOVER</span>

            <h1>Welcome back</h1>

            <p>
                Sign in to continue shopping.
            </p>
        </div>

        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="alert alert-success">
                @success
            </div>
        }

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden"
                   name="returnUrl"
                   value="@Model.ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Input.UsernameOrEmail"
       class="form-label"></label>

<input asp-for="Input.UsernameOrEmail"
       class="form-control"
       placeholder="Username or email"
       autocomplete="username" />

<span asp-validation-for="Input.UsernameOrEmail"
      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password"
                       class="form-label"></label>

                <input asp-for="Input.Password"
                       class="form-control"
                       placeholder="Your password"
                       autocomplete="current-password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger"></span>
            </div>

            <button type="submit"
                    class="btn btn-dark w-100">
                Sign in
            </button>
        </form>

        <div class="text-center mt-4">
            Don't have an account?
            <a asp-page="/Account/Register">
                Create one
            </a>
        </div>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}