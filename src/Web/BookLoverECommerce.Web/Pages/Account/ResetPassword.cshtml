@page
@model BookLoverECommerce.Web.Pages.Account.ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="account-form-page">

    <div class="container">

        <div class="account-form-card">

            <div class="account-form-header">

                <span class="section-label">
                    ACCOUNT RECOVERY
                </span>

                <h1>
                    Create New Password
                </h1>

                <p>
                    Choose a new password for your account.
                </p>

            </div>

            @if (!string.IsNullOrWhiteSpace(
                Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post">

                <input asp-for="Input.Email"
                       type="hidden" />

                <input asp-for="Input.Token"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Input.NewPassword"
                           class="form-label">
                    </label>

                    <input asp-for="Input.NewPassword"
                           class="form-control form-control-lg"
                           autocomplete="new-password" />

                    <span asp-validation-for="Input.NewPassword"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-4">

                    <label asp-for="Input.ConfirmPassword"
                           class="form-label">
                    </label>

                    <input asp-for="Input.ConfirmPassword"
                           class="form-control form-control-lg"
                           autocomplete="new-password" />

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <div class="password-help">

                    <strong>
                        Choose a strong password
                    </strong>

                    <span>
                        Use a password that is different from
                        passwords you use on other accounts.
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-dark btn-lg w-100">
                    Reset Password
                </button>

            </form>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}