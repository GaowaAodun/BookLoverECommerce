@page "{id:guid}"
@model BookLoverECommerce.Cms.Pages.Prices.EditModel

@{
    ViewData["Title"] = "Edit Price";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Edit price</h1>

    <p class="text-muted mb-0">
        @(string.IsNullOrWhiteSpace(Model.ProductName)
            ? "Update this product price."
            : $"Update the price for {Model.ProductName}.")
    </p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="Input.ProductId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            @if (Model.Input.ProductId.HasValue)
            {
                <div class="mb-3">
                    <label class="form-label">Product</label>

                    <input class="form-control"
                           value="@Model.ProductName"
                           disabled />

                    <div class="form-text">
                        Product ID: @Model.Input.ProductId
                    </div>
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.BasePrice"
                           class="form-label">
                    </label>

                    <input asp-for="Input.BasePrice"
                           class="form-control"
                           type="number"
                           min="0.01"
                           step="0.01" />

                    <span asp-validation-for="Input.BasePrice"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Currency"
                           class="form-label">
                    </label>

                    <select asp-for="Input.Currency"
                            asp-items="Html.GetEnumSelectList<
                                BookLoverECommerce.Cms.Models.Prices.Currency>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Input.Currency"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.SalePrice"
                           class="form-label">
                    </label>

                    <input asp-for="Input.SalePrice"
                           class="form-control"
                           type="number"
                           min="0.01"
                           step="0.01"
                           placeholder="Optional" />

                    <span asp-validation-for="Input.SalePrice"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6"></div>

                <div class="col-md-6">
                    <label asp-for="Input.SaleStartDate"
                           class="form-label">
                    </label>

                    <input asp-for="Input.SaleStartDate"
                           class="form-control"
                           type="datetime-local" />

                    <span asp-validation-for="Input.SaleStartDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.SaleEndDate"
                           class="form-label">
                    </label>

                    <input asp-for="Input.SaleEndDate"
                           class="form-control"
                           type="datetime-local" />

                    <span asp-validation-for="Input.SaleEndDate"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit"
                        class="btn btn-primary">
                    Save changes
                </button>

                <a asp-page="/Prices/Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}