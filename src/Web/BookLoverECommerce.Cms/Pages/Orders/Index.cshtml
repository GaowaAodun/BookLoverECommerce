@page
@model BookLoverECommerce.Cms.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Orders</h1>
            <p class="text-muted mb-0">
                View and manage customer orders.
            </p>
        </div>

        <span class="badge bg-secondary fs-6">
            @Model.Orders.Count order(s)
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
            </button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage

            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
            </button>
        </div>
    }

    @if (Model.Orders.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <h2 class="h5">No orders found</h2>

                <p class="text-muted mb-0">
                    Customer orders will appear here after they are created.
                </p>
            </div>
        </div>
    }
    else
    {
        @foreach (var order in Model.Orders.OrderByDescending(
            order => order.CreatedAt))
        {
            var statusClass = order.Status switch
            {
                "PendingPayment" => "bg-warning text-dark",
                "Paid" => "bg-info text-dark",
                "Processing" => "bg-primary",
                "Shipped" => "bg-secondary",
                "Delivered" => "bg-success",
                "Completed" => "bg-success",
                "Cancelled" => "bg-danger",
                _ => "bg-dark"
            };

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <div class="row align-items-center g-3">
                        <div class="col-md-4">
                            <div class="small text-muted">
                                Order ID
                            </div>

                            <div class="fw-semibold text-break">
                                @order.Id
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="small text-muted">
                                Customer ID
                            </div>

                            <div class="text-break">
                                @order.CustomerId
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="small text-muted">
                                Created
                            </div>

                            <div>
                                @order.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            </div>
                        </div>

                        <div class="col-md-1">
                            <div class="small text-muted">
                                Total
                            </div>

                            <div class="fw-bold">
                                @order.TotalAmount.ToString("C")
                            </div>
                        </div>

                        <div class="col-md-2 text-md-end">
                            <span class="badge @statusClass">
                                @order.Status
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <h2 class="h6 mb-3">Order items</h2>

                    @if (order.Items.Count == 0)
                    {
                        <p class="text-muted">
                            This order does not contain any items.
                        </p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Product ID</th>
                                        <th class="text-end">Unit price</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Subtotal</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in order.Items)
                                    {
                                        <tr>
                                            <td>@item.ProductName</td>

                                            <td>
                                                <small class="text-muted">
                                                    @item.ProductId
                                                </small>
                                            </td>

                                            <td class="text-end">
                                                @item.UnitPrice.ToString("C")
                                            </td>

                                            <td class="text-end">
                                                @item.Quantity
                                            </td>

                                            <td class="text-end fw-semibold">
                                                @item.Subtotal.ToString("C")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <hr />

                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        @switch (order.Status)
                        {
                            case "PendingPayment":
                                <form method="post" asp-page-handler="MarkPaid" class="row g-2 align-items-end">

                                    <input type="hidden" name="orderId" value="@order.Id" />

                                    <div class="col-auto">
                                        <label class="form-label" for="payment-@order.Id">
                                            Payment reference
                                        </label>

                                        <input id="payment-@order.Id" name="paymentReference" class="form-control" maxlength="200"
                                               required />
                                    </div>

                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-success">
                                            Mark as Paid
                                        </button>
                                    </div>
                                </form>
                                break;

                            case "Paid":
                                <form method="post" asp-page-handler="StartProcessing">

                                    <input type="hidden" name="orderId" value="@order.Id" />

                                    <button type="submit" class="btn btn-primary">
                                        Start Processing
                                    </button>
                                </form>
                                break;

                            case "Processing":
                                <form method="post" asp-page-handler="Ship" class="row g-2 align-items-end">

                                    <input type="hidden" name="orderId" value="@order.Id" />

                                    <div class="col-md-3">
                                        <label class="form-label" for="carrier-@order.Id">
                                            Carrier
                                        </label>

                                        <input id="carrier-@order.Id" name="carrier" class="form-control" maxlength="100" required />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label" for="tracking-number-@order.Id">
                                            Tracking number
                                        </label>

                                        <input id="tracking-number-@order.Id" name="trackingNumber" class="form-control" maxlength="100"
                                               required />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label" for="tracking-url-@order.Id">
                                            Tracking URL
                                        </label>

                                        <input id="tracking-url-@order.Id" name="trackingUrl" type="url" class="form-control"
                                               maxlength="500" placeholder="https://..." />
                                    </div>

                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-primary w-100">
                                            Ship Order
                                        </button>
                                    </div>
                                </form>
                                break;

                            case "Shipped":
                                <span class="text-muted">
                                    Waiting for the customer to confirm receipt.
                                </span>
                                break;

                            case "Delivered":
                                <form method="post" asp-page-handler="Complete">

                                    <input type="hidden" name="orderId" value="@order.Id" />

                                    <button type="submit" class="btn btn-success">
                                        Complete Order
                                    </button>
                                </form>
                                break;

                            case "Completed":
                                <span class="text-success">
                                    This order has been completed.
                                </span>
                                break;

                            case "Cancelled":
                                <span class="text-danger">
                                    This order has been cancelled.
                                </span>
                                break;

                            default:
                                <span class="text-muted">
                                    No administrator action is available for
                                    this status.
                                </span>
                                break;
                        }
                    </div>
                </div>

                <div class="card-footer bg-light text-muted small">
                    Last updated:
                    @order.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            </div>
        }
    }
</div>