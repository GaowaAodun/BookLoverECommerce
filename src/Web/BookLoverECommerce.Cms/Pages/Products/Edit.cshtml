@page "{id:int}"
@model BookLoverECommerce.Cms.Pages.Products.EditModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="d-flex justify-content-between
            align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Edit product</h1>
        <p class="text-muted mb-0">
            Update the product information.
        </p>
    </div>

    <a asp-page="/Products/Index"
       class="btn btn-outline-secondary">
        Back to products
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Input.Name"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Name"
                           class="form-control" />

                    <span asp-validation-for="Input.Name"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4">
                    <label class="form-label">SKU</label>

                    <input value="@Model.Sku"
                           class="form-control"
                           disabled />

                    <div class="form-text">
                        SKU cannot be changed.
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="Input.Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Input.Description"
                              class="form-control"
                              rows="5">
                    </textarea>

                    <span asp-validation-for="Input.Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.CategoryId"
                           class="form-label">
                    </label>

                    <select asp-for="Input.CategoryId"
                            asp-items="Model.Categories"
                            class="form-select">
                        <option value="">Select a category</option>
                    </select>

                    <span asp-validation-for="Input.CategoryId"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.ProductType"
                           class="form-label">
                    </label>

                    <select asp-for="Input.ProductType"
                            asp-items="Model.ProductTypes"
                            class="form-select">
                    </select>

                    <span asp-validation-for="Input.ProductType"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Price"
                           class="form-label">
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">$</span>

                        <input asp-for="Input.Price"
                               class="form-control"
                               type="number"
                               min="0"
                               step="0.01" />
                    </div>

                    <span asp-validation-for="Input.Price"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.StockQuantity"
                           class="form-label">
                    </label>

                    <input asp-for="Input.StockQuantity"
                           class="form-control"
                           type="number"
                           min="0" />

                    <span asp-validation-for="Input.StockQuantity"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.Brand"
                           class="form-label">
                    </label>

                    <input asp-for="Input.Brand"
                           class="form-control" />

                    <span asp-validation-for="Input.Brand"
                          class="text-danger">
                    </span>
                </div>

                <div class="col-12">
                    <label asp-for="Input.ThumbnailUrl"
                           class="form-label">
                    </label>

                    <input asp-for="Input.ThumbnailUrl"
                           class="form-control"
                           type="url" />

                    <span asp-validation-for="Input.ThumbnailUrl"
                          class="text-danger">
                    </span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-page="/Products/Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Save changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}