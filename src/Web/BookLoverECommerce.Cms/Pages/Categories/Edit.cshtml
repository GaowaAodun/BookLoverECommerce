@page "{id:int}"
@model BookLoverECommerce.Cms.Pages.Categories.EditModel

@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-xl-8 col-lg-9">
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div class="d-flex align-items-center gap-3">
                <a asp-page="/Categories/Index" class="btn btn-outline-secondary">
                    Back
                </a>

                <div>
                    <h1 class="h2 mb-1">Edit category</h1>

                    <p class="text-muted mb-0">
                        Update category #@Model.Id
                    </p>
                </div>
            </div>

            @if (Model.IsActive)
            {
                <span class="badge bg-success fs-6">
                    Active
                </span>
            }
            else
            {
                <span class="badge bg-secondary fs-6">
                    Inactive
                </span>
            }
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h2 class="h5 mb-0">Category details</h2>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <input asp-for="Id" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert">
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            Category ID
                        </label>

                        <input value="@Model.Id" class="form-control" disabled />

                        <div class="form-text">
                            Category IDs are generated automatically and
                            cannot be changed.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Name" class="form-label fw-semibold">
                        </label>

                        <input asp-for="Input.Name" class="form-control" autofocus />

                        <span asp-validation-for="Input.Name" class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Description" class="form-label fw-semibold">
                        </label>

                        <textarea asp-for="Input.Description" class="form-control" rows="4"></textarea>

                        <span asp-validation-for="Input.Description" class="text-danger">
                        </span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Input.ParentCategoryId" class="form-label fw-semibold">
                            </label>

                            @if (Model.IsRootCategory)
                            {
                                <input type="hidden" asp-for="Input.ParentCategoryId" />

                                <input type="text" class="form-control" value="No parent — root category" disabled />

                                <div class="form-text">
                                    This is already a root category. A root category cannot
                                    be changed into a child category.
                                </div>
                            }
                            else
                            {
                                <select asp-for="Input.ParentCategoryId" asp-items="Model.ParentCategoryOptions"
                                        class="form-select">
                                    <option value="">
                                        No parent — change to root category
                                    </option>
                                </select>

                                <div class="form-text">
                                    Select another active root category, or select
                                    “No parent” to change this child into a root category.
                                </div>
                            }

                            <span asp-validation-for="Input.ParentCategoryId" class="text-danger">
                            </span>

                            <span asp-validation-for="Input.ParentCategoryId" class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 mb-4">
                            <label asp-for="Input.DisplayOrder" class="form-label fw-semibold">
                            </label>

                            <input asp-for="Input.DisplayOrder" class="form-control" type="number" min="0" max="9999" />

                            <div class="form-text">
                                Lower numbers appear first.
                            </div>

                            <span asp-validation-for="Input.DisplayOrder" class="text-danger">
                            </span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3
                        border-top">
                        <a asp-page="/Categories/Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Save changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}