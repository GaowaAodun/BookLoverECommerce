@page
@model BookLoverECommerce.Cms.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Categories</h1>

        <p class="text-muted mb-0">
            Organize products into catalogue categories.
        </p>
    </div>

    <a asp-page="/Categories/Create" class="btn btn-primary">
        Add category
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
        </button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @Model.ErrorMessage
    </div>
}

@if (Model.Categories.Count == 0 &&
     string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h2 class="h5">No categories found</h2>

            <p class="text-muted">
                Create your first category to organize the catalogue.
            </p>

            <a asp-page="/Categories/Create" class="btn btn-primary">
                Add category
            </a>
        </div>
    </div>
}
else if (Model.Categories.Count > 0)
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Parent</th>
                        <th class="text-end">Display order</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        var parent = Model.Categories.FirstOrDefault(
                            item => item.Id ==
                                category.ParentCategoryId);

                        <tr>
                            <td>
                                <code>#@category.Id</code>
                            </td>

                            <td class="fw-semibold">
                                @category.Name
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(
                                    category.Description))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @category.Description
                                }
                            </td>

                            <td>
                                @if (category.ParentCategoryId.HasValue)
                                {
                                    <span>
                                        @(parent?.Name ??
                                            $"#{category.ParentCategoryId}")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Root category
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                @category.DisplayOrder
                            </td>

                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="d-flex flex-wrap gap-2
                                    justify-content-end">
                                    <a asp-page="/Categories/Edit" asp-route-id="@category.Id" class="btn btn-sm
                                        btn-outline-primary">
                                        Edit
                                    </a>

                                    @if (category.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Deactivate" asp-route-id="@category.Id" onsubmit="return confirm(
                                            'Deactivate this category?');">
                                            <button type="submit" class="btn btn-sm
                                                btn-outline-warning">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Activate" asp-route-id="@category.Id" onsubmit="return confirm(
                                            'Activate this category?');">
                                            <button type="submit" class="btn btn-sm
                                                btn-outline-success">
                                                Activate
                                            </button>
                                        </form>
                                    }

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@category.Id" onsubmit="return confirm(
                                        'Delete this category? This action cannot be undone.');">
                                        <button type="submit" class="btn btn-sm
                                            btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}