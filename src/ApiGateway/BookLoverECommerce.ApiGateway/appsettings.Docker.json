{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "products-route": {
        "products-exact-route": {
          "ClusterId": "products-cluster",
          "Match": {
            "Path": "/api/products"
          }
        },
        "products-subpath-route": {
          "ClusterId": "products-cluster",
          "Match": {
            "Path": "/api/products/{**catch-all}"
          }
        }
      },
      "price-route": {
        "ClusterId": "price-cluster",
        "Match": {
          "Path": "/api/price/{**catch-all}"
        }
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-api:8080/"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://products-api:8080/"
          }
        }
      },
      "price-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://price-api:8080/"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://cart-api:8080/"
          }
        }
      }
    }
  }
}